<!--
  Three bricks and a ball, in index.html's own neon palette (index.html:22-40)
  — cyan/magenta/amber bricks, a lime ball with a soft two-ring bloom (flat
  fillAlpha rings; VectorDrawable has no blur filter), a silver paddle
  sliver. Everything sits inside the 72x72dp safe zone centered in the
  108x108dp canvas — the outer ~18dp margin can be cropped depending on the
  launcher's mask shape (circle/squircle/rounded square), so nothing here
  extends past x/y 18-90. Pure vector XML, no raster, no tooling — reviewed
  as SVG (same path-data grammar) before being hand-transcribed here; see
  docs/mobile-migration.md Phase 4.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ball bloom, outer ring -->
    <path
        android:fillColor="#9dff1e"
        android:fillAlpha="0.22"
        android:pathData="M36,66 A18,18 0 1 0 72,66 A18,18 0 1 0 36,66 Z" />
    <!-- Ball bloom, inner ring -->
    <path
        android:fillColor="#9dff1e"
        android:fillAlpha="0.35"
        android:pathData="M40,66 A14,14 0 1 0 68,66 A14,14 0 1 0 40,66 Z" />
    <!-- Brick: cyan -->
    <path
        android:fillColor="#2de2e6"
        android:pathData="M21,30 L35,30 A3,3 0 0 1 38,33 L38,41 A3,3 0 0 1 35,44 L21,44 A3,3 0 0 1 18,41 L18,33 A3,3 0 0 1 21,30 Z" />
    <!-- Brick: magenta -->
    <path
        android:fillColor="#ff2e88"
        android:pathData="M47,30 L61,30 A3,3 0 0 1 64,33 L64,41 A3,3 0 0 1 61,44 L47,44 A3,3 0 0 1 44,41 L44,33 A3,3 0 0 1 47,30 Z" />
    <!-- Brick: amber -->
    <path
        android:fillColor="#ffb627"
        android:pathData="M73,30 L87,30 A3,3 0 0 1 90,33 L90,41 A3,3 0 0 1 87,44 L73,44 A3,3 0 0 1 70,41 L70,33 A3,3 0 0 1 73,30 Z" />
    <!-- Ball -->
    <path
        android:fillColor="#9dff1e"
        android:pathData="M43,66 A11,11 0 1 0 65,66 A11,11 0 1 0 43,66 Z" />
    <!-- Paddle sliver -->
    <path
        android:fillColor="#c3cee0"
        android:pathData="M37,80 L71,80 A3,3 0 0 1 74,83 A3,3 0 0 1 71,86 L37,86 A3,3 0 0 1 34,83 A3,3 0 0 1 37,80 Z" />
</vector>
